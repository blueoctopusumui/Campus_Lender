# CampusLend - .gitignore
# Authors: Amani Yadav (24BCE0246) & Sanjana B S (24BCE2516)

# Environment variables - NEVER commit these
.env
.env.local
.env.production

# Node modules
node_modules/
backend/node_modules/
frontend/node_modules/

# Build output
frontend/dist/
backend/dist/

# Database dumps and backups
*.sql.gz
*_backup.sql
campuslend_backup_*.sql

# Prisma
backend/prisma/migrations/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Keys and secrets
*.pem
*.key
*.cert
serviceAccountKey.json

# Docker
.dockerignore
